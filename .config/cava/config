[general]
# Cap framerate to keep movement from being too frantic
framerate = 60

# Keep the bars very thin and spaced apart for a minimalist look
bar_width = 2
bar_spacing = 1

# FORCE CAVA's bars to stay very low so they don't jump up into Aizen's face (lower from default 90)
max_height = 45

# Auto-sensitivity prevents huge spikes from overtaking the screen
autosens = 1
sensitivity = 100


[input]
# Adjust methods based on your system (pipewire, pulse, alsa, etc.)
method = pipewire
source = auto


[output]
# Lightweight CLI rendering
method = noncurses

# Keep standard bottom-aligned visualizer
orientation = bottom

# Using STEREO separates left and right channel inputs.
channels = stereo

# REVERSE = 1 pushes the massive low frequencies (bass) to the extreme outer 
# left and right edges, while leaving the high frequencies (which are 
# generally much quieter and flatter) near the center to avoid Aizen's chin.
reverse = 1

# Reduce screen flickering in terminal emulators
synchronized_sync = 1


[color]
# By using 'default', CAVA will automatically inherit the colors generated
# by pywal inside your active terminal scheme. 
background = default
foreground = default

# Fallback dark grey/black gradients if pywal isn't active.
# Un-comment these (remove the ;) to activate the fallback manually.
; gradient = 1
; gradient_color_1 = '#0c0c0c' # Ultra-dark grey/black
; gradient_color_2 = '#141414'
; gradient_color_3 = '#1d1d1d'
; gradient_color_4 = '#252525'
; gradient_color_5 = '#2e2e2e'
; gradient_color_6 = '#363636'
; gradient_color_7 = '#424242'
; gradient_color_8 = '#505050' # Minimal dark gray


[smoothing]
# Slow down the falls and apply high noise reduction 
# to keep the movement fluid, minimalist, and non-distracting.
noise_reduction = 92

# Monstercat smoothing will blend and flatten transitions
monstercat = 1
waves = 0


[eq]
# THE FIX FOR AIZEN: Force-suppress the mid and high frequencies.
# By dropping mid-high values, the bars in the center will barely register,
# effectively carving out a visual empty valley right where Aizen's chin and neck are.
1 = 1.8 # Boost bass on outer edges (since they now sit on the left/right sides)
2 = 1.3
3 = 0.6 # Drop mid-tones to flatten the middle
4 = 0.3 # Severely drop mid-tones in the center
5 = 0.2 # Flatten center highs
6 = 0.2 # Flatten center highs
7 = 0.4 # Bring back slight outer highs
8 = 0.8 # Bring back slight outer highs
